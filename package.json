{
  "name": "semantic-highlighter",
  "version": "0.1.0",
  "description": "Browser extension: select a passage and the page lights up as a heatmap of semantically related sentences.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test 'test/unit/*.test.js'",
    "test:e2e": "node test/e2e.mjs",
    "lint": "web-ext lint --source-dir dist/firefox",
    "package:firefox": "web-ext build --source-dir dist/firefox --overwrite-dest",
    "test:e2e:firefox": "node test/e2e-firefox.mjs"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer": "25.12.0",
    "web-ext": "10.7.0"
  },
  "private": true
}
